# =====================================================================
# TONINHO IMÓVEIS — Variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha com os seus valores.
# NUNCA envie o arquivo .env.local para o GitHub.
# =====================================================================

# URL do projeto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon / publishable). Pode ser exposta no navegador:
# o acesso aos dados é protegido pelas regras RLS do banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Chave secreta (service_role / secret). SOMENTE servidor — nunca use
# o prefixo NEXT_PUBLIC_. Usada para criar administradores
# (script "npm run admin:create" e tela "Usuários" do painel).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Endereço público do site (sem barra no final). Usado em SEO,
# sitemap, Open Graph e links de compartilhamento.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Opcional) WhatsApp padrão, somente números com DDI e DDD.
# O número configurado no painel (Configurações) tem prioridade.
NEXT_PUBLIC_WHATSAPP_NUMBER=5500000000000
